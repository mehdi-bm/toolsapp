# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
android/build/
android/app/.cxx/
# Gradle build output for the vendored ffmpeg_kit_audio_flutter module.
third_party/ffmpeg_kit_audio_flutter/android/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local secrets for --dart-define-from-file — never commit real API keys.
ads.local.json
*.local.json

# Release signing — never commit the keystore or its password.
android/key.properties
android/keystore/
